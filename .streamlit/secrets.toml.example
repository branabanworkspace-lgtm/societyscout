# Copy this to .streamlit/secrets.toml for local use, or paste the lines into
# Settings > Secrets on Streamlit Cloud. Never commit the real secrets.toml.

SOCIETYSCOUT_CONTACT = "outreach@your-brand.co.uk"

# Optional. Makes searching by university name work from a hosted server.
# BRAVE_API_KEY = "your-brave-search-api-key"

# Tells the app it is hosted, so it warns that saved data is temporary.
SOCIETYSCOUT_CLOUD = "true"
